diff --git a/android/app/build.gradle b/android/app/build.gradle
index 6be86b810..5b9108443 100644
--- a/android/app/build.gradle
+++ b/android/app/build.gradle
@@ -3,7 +3,7 @@ apply plugin: 'com.android.application'
 android {
 	ndkVersion "$ndk_version"
 	defaultConfig {
-		applicationId 'net.minetest.minetest'
+		applicationId 'org.lumo.oficina'
 		minSdkVersion 21
 		compileSdk = 34
 		targetSdkVersion 35
@@ -113,6 +113,21 @@ tasks.register("prepareAssets") {
 			from "${localeFolder}" into "${assetsFolder}/locale"
 		}
 
+		// O APK oficial do Luanti sai sem jogo nenhum: quem instala baixa um
+		// pelo ContentDB dentro do app. Aqui o Lumo vai junto, senão o APK
+		// abriria numa lista vazia.
+		//
+		// O `.git` precisa ficar de fora -- games/lumo e um repositorio, e o
+		// historico dele sozinho passa de dez megabytes dentro do APK. `utils`
+		// sao as ferramentas de validacao, que nao servem para nada num
+		// telefone.
+		copy {
+			from("${projRoot}/games/lumo") {
+				exclude ".git/**", ".gitignore", "utils/**", "README.md"
+			}
+			into "${assetsFolder}/games/lumo"
+		}
+
 		file("${assetsFolder}/.nomedia").text = ""
 	}
 }
